<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="sg.edu.nus.iss.c2csectrade.mapper.CartItemMapper">

    <resultMap id="CartItemResultMap" type="sg.edu.nus.iss.c2csectrade.entity.CartItem">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="productId" column="product_id"/>
        <result property="quantity" column="quantity"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <association property="product" javaType="sg.edu.nus.iss.c2csectrade.entity.Product">
            <id property="id" column="p_id"/>
            <result property="userId" column="p_user_id"/>
            <result property="name" column="p_name"/>
            <result property="price" column="p_price"/>
            <result property="stock" column="p_stock"/>
            <result property="reservedStock" column="p_reserved_stock"/>
            <result property="status" column="p_status"/>
            <result property="category" column="p_category"/>
            <result property="location" column="p_location"/>
            <result property="conditionLevel" column="p_condition_level"/>
        </association>
    </resultMap>

    <sql id="joinedColumns">
        c.id, c.user_id, c.product_id, c.quantity, c.created_at, c.updated_at,
        p.id AS p_id, p.user_id AS p_user_id, p.name AS p_name, p.price AS p_price,
        p.stock AS p_stock, p.reserved_stock AS p_reserved_stock, p.status AS p_status,
        p.category AS p_category, p.location AS p_location, p.condition_level AS p_condition_level
    </sql>

    <select id="selectByUserId" resultMap="CartItemResultMap">
        SELECT <include refid="joinedColumns"/>
        FROM oms_cart_item c JOIN pms_product p ON p.id = c.product_id
        WHERE c.user_id = #{userId}
        ORDER BY c.updated_at DESC
    </select>

    <select id="selectByUserAndProduct" resultMap="CartItemResultMap">
        SELECT <include refid="joinedColumns"/>
        FROM oms_cart_item c JOIN pms_product p ON p.id = c.product_id
        WHERE c.user_id = #{userId} AND c.product_id = #{productId}
    </select>

    <select id="selectById" resultMap="CartItemResultMap">
        SELECT <include refid="joinedColumns"/>
        FROM oms_cart_item c JOIN pms_product p ON p.id = c.product_id
        WHERE c.id = #{id}
    </select>

    <select id="selectByIds" resultMap="CartItemResultMap">
        SELECT <include refid="joinedColumns"/>
        FROM oms_cart_item c JOIN pms_product p ON p.id = c.product_id
        WHERE c.id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>

    <insert id="insert" parameterType="sg.edu.nus.iss.c2csectrade.entity.CartItem"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO oms_cart_item (user_id, product_id, quantity)
        VALUES (#{userId}, #{productId}, #{quantity})
    </insert>

    <update id="updateQuantity">
        UPDATE oms_cart_item SET quantity = #{quantity} WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM oms_cart_item WHERE id = #{id}
    </delete>

    <delete id="deleteByIds">
        DELETE FROM oms_cart_item WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM oms_cart_item WHERE user_id = #{userId}
    </delete>
</mapper>
