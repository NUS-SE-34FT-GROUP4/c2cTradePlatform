<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="sg.edu.nus.iss.c2csectrade.mapper.BargainCampaignHelperMapper">

    <resultMap id="BargainCampaignHelperResultMap" type="sg.edu.nus.iss.c2csectrade.entity.BargainCampaignHelper">
        <id property="id" column="id"/>
        <result property="campaignId" column="campaign_id"/>
        <result property="userId" column="user_id"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="sg.edu.nus.iss.c2csectrade.entity.BargainCampaignHelper"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO bargain_campaign_helper (campaign_id, user_id)
        VALUES (#{campaignId}, #{userId})
    </insert>

    <select id="selectByCampaignId" resultMap="BargainCampaignHelperResultMap">
        SELECT * FROM bargain_campaign_helper
        WHERE campaign_id = #{campaignId}
        ORDER BY created_at ASC, id ASC
    </select>
</mapper>
