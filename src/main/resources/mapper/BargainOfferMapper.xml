<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="sg.edu.nus.iss.c2csectrade.mapper.BargainOfferMapper">

    <resultMap id="BargainOfferResultMap" type="sg.edu.nus.iss.c2csectrade.entity.BargainOffer">
        <id property="id" column="id"/>
        <result property="productId" column="product_id"/>
        <result property="buyerId" column="buyer_id"/>
        <result property="sellerId" column="seller_id"/>
        <result property="from" column="offer_from"/>
        <result property="price" column="price"/>
        <result property="status" column="status"/>
        <result property="orderId" column="order_id"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="sg.edu.nus.iss.c2csectrade.entity.BargainOffer"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO bargain_offer
            (product_id, buyer_id, seller_id, offer_from, price, status)
        VALUES
            (#{productId}, #{buyerId}, #{sellerId}, #{from}, #{price}, #{status})
    </insert>

    <select id="selectById" resultMap="BargainOfferResultMap">
        SELECT * FROM bargain_offer WHERE id = #{id}
    </select>

    <select id="selectThread" resultMap="BargainOfferResultMap">
        SELECT * FROM bargain_offer
        WHERE product_id = #{productId} AND buyer_id = #{buyerId}
        ORDER BY created_at ASC, id ASC
    </select>

    <select id="selectByProduct" resultMap="BargainOfferResultMap">
        SELECT * FROM bargain_offer
        WHERE product_id = #{productId}
        ORDER BY created_at ASC, id ASC
    </select>

    <update id="updateStatus">
        UPDATE bargain_offer SET status = #{status}, order_id = #{orderId} WHERE id = #{id}
    </update>
</mapper>
