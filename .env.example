# Copy to .env (locally, or on the staging server). .env is git-ignored; never
# commit the filled-in version: NFR 6.2 says no secret may be committed.
# Locally only JWT_SECRET is required; the rest are for compose.staging.yaml.

# Lowercase GitHub org that owns the published images
IMAGE_OWNER=nus-se-34ft-group4
# Commit SHA to run; the pipeline sets this per deployment
IMAGE_TAG=latest

MYSQL_PASSWORD=
# Also used as the backend's MinIO access key, so the two cannot drift apart
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
# Public address of this server, the one a browser can reach
MINIO_PUBLIC_ENDPOINT=http://your-server-ip:9000
# Base64 secret for signing JWTs, at least 64 bytes (HS512). Generate with:
#   openssl rand -base64 64 | tr -d '\n'
# Staging gets its own from the STAGING_JWT_SECRET secret of the staging environment.
JWT_SECRET=
