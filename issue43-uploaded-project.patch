--- /dev/null
+++ b/src/test/java/lut/cn/c2cplatform/TransactionAcceptanceIT.java
@@ -0,0 +1,140 @@
+package lut.cn.c2cplatform;
+
+import lut.cn.c2cplatform.dto.PaymentRequest;
+import lut.cn.c2cplatform.entity.Order;
+import lut.cn.c2cplatform.scheduled.OrderExpireTask;
+import lut.cn.c2cplatform.service.CreditScoreService;
+import lut.cn.c2cplatform.service.OrderService;
+import lut.cn.c2cplatform.service.impl.OrderServiceImpl;
+import org.apache.ibatis.session.SqlSessionFactory;
+import org.junit.jupiter.api.*;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.mybatis.spring.SqlSessionFactoryBean;
+import org.mybatis.spring.annotation.MapperScan;
+import org.springframework.context.annotation.*;
+import org.springframework.core.io.support.PathMatchingResourcePatternResolver;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.datasource.DataSourceTransactionManager;
+import org.springframework.jdbc.datasource.DriverManagerDataSource;
+import org.springframework.security.crypto.bcrypt.BCrypt;
+import org.springframework.transaction.PlatformTransactionManager;
+import org.springframework.transaction.annotation.EnableTransactionManagement;
+import org.testcontainers.containers.MySQLContainer;
+
+import javax.sql.DataSource;
+import java.math.BigDecimal;
+import java.util.UUID;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.mock;
+
+/** Real mapper XML, uploaded init.sql and Spring transaction proxies; no mapper mocks. */
+class TransactionAcceptanceIT {
+    static final MySQLContainer<?> MYSQL = new MySQLContainer<>("mysql:8.0.36")
+            .withDatabaseName("trade").withUsername("integration").withPassword("integration")
+            .withInitScript("init.sql");
+    static AnnotationConfigApplicationContext context;
+    JdbcTemplate jdbc; OrderService orders; OrderExpireTask expiry;
+    Long buyer, seller, product; Integer orderId;
+    @BeforeAll static void start() {
+        MYSQL.start(); context = new AnnotationConfigApplicationContext(Config.class);
+    }
+    @AfterAll static void stop() {
+        if (context != null) context.close(); MYSQL.stop();
+    }
+    @Configuration @EnableTransactionManagement
+    @MapperScan("lut.cn.c2cplatform.mapper")
+    static class Config {
+        @Bean DataSource dataSource() { return new DriverManagerDataSource(MYSQL.getJdbcUrl(), MYSQL.getUsername(), MYSQL.getPassword()); }
+        @Bean PlatformTransactionManager transactionManager(DataSource ds) { return new DataSourceTransactionManager(ds); }
+        @Bean SqlSessionFactory sqlSessionFactory(DataSource ds) throws Exception {
+            SqlSessionFactoryBean f = new SqlSessionFactoryBean(); f.setDataSource(ds);
+            org.apache.ibatis.session.Configuration c = new org.apache.ibatis.session.Configuration();
+            c.setMapUnderscoreToCamelCase(true); f.setConfiguration(c);
+            f.setTypeAliasesPackage("lut.cn.c2cplatform.entity");
+            f.setMapperLocations(new PathMatchingResourcePatternResolver().getResources("classpath*:mapper/*.xml"));
+            return f.getObject();
+        }
+        @Bean OrderService orderService() { return new OrderServiceImpl(); }
+        @Bean OrderExpireTask expiry() { return new OrderExpireTask(); }
+        @Bean CreditScoreService creditScoreService() { return mock(CreditScoreService.class); }
+    }
+    @BeforeEach void seed() {
+        jdbc = new JdbcTemplate(context.getBean(DataSource.class)); orders = context.getBean(OrderService.class); expiry = context.getBean(OrderExpireTask.class);
+        buyer = user("buyer", "100.00"); seller = user("seller", "0.00");
+        jdbc.update("INSERT INTO pms_product(user_id,name,price,stock,status) VALUES (?,'Issue43 item',30,2,1)", seller);
+        product = jdbc.queryForObject("SELECT id FROM pms_product WHERE user_id=?", Long.class, seller);
+        orderId = orders.createOrderForProduct(buyer.intValue(), product, 1).getId();
+    }
+    Long user(String role, String balance) {
+        String name = role + "-" + UUID.randomUUID();
+        jdbc.update("INSERT INTO users(username,email,password_hash,payment_password_hash,balance) VALUES (?,?,?,?,?)",
+                name, name + "@example.test", BCrypt.hashpw("login", BCrypt.gensalt(4)), BCrypt.hashpw("123456", BCrypt.gensalt(4)), new BigDecimal(balance));
+        return jdbc.queryForObject("SELECT id FROM users WHERE username=?", Long.class, name);
+    }
+    @AfterEach void cleanup() {
+        if (orderId != null) {
+            jdbc.update("DELETE FROM transactions WHERE order_id=?", orderId);
+            jdbc.update("DELETE FROM order_items WHERE order_id=?", orderId);
+            jdbc.update("DELETE FROM orders WHERE id=?", orderId);
+        }
+        if (product != null) jdbc.update("DELETE FROM pms_product WHERE id=?", product);
+        if (buyer != null) jdbc.update("DELETE FROM users WHERE id=?", buyer);
+        if (seller != null) jdbc.update("DELETE FROM users WHERE id=?", seller);
+    }
+    PaymentRequest payment(String method, String pin) {
+        PaymentRequest r = new PaymentRequest(); r.setPaymentMethod(method); r.setPassword(pin); return r;
+    }
+    String status() { return jdbc.queryForObject("SELECT status FROM orders WHERE id=?", String.class, orderId); }
+    int stock() { return jdbc.queryForObject("SELECT stock FROM pms_product WHERE id=?", Integer.class, product); }
+    int ledger() { return jdbc.queryForObject("SELECT COUNT(*) FROM transactions WHERE order_id=?", Integer.class, orderId); }
+    BigDecimal balance() { return jdbc.queryForObject("SELECT balance FROM users WHERE id=?", BigDecimal.class, buyer); }
+    @ParameterizedTest @ValueSource(strings = {"balance", "alipay", "wechat", "bank"})
+    void successfulPaymentDeductsStockOnceAndCannotBeExpired(String method) {
+        orders.payOrder(orderId, buyer.intValue(), payment(method, "123456"));
+        assertEquals("PAID", status()); assertEquals(1, stock()); assertEquals(1, ledger());
+        assertEquals(new BigDecimal("balance".equals(method) ? "70.00" : "100.00"), balance());
+        assertThrows(RuntimeException.class, () -> orders.payOrder(orderId, buyer.intValue(), payment(method, "123456")));
+        jdbc.update("UPDATE orders SET expire_time=DATE_SUB(NOW(),INTERVAL 1 MINUTE) WHERE id=?", orderId);
+        expiry.closeExpiredOrders(); assertEquals("PAID", status()); assertEquals(1, stock()); assertEquals(1, ledger());
+    }
+    @Test void insufficientBalanceRollsBackEarlierStockDeduction() {
+        jdbc.update("UPDATE users SET balance=5 WHERE id=?", buyer);
+        assertThrows(RuntimeException.class, () -> orders.payOrder(orderId, buyer.intValue(), payment("balance", "123456")));
+        assertEquals("PENDING", status()); assertEquals(2, stock()); assertEquals(0, ledger()); assertEquals(new BigDecimal("5.00"), balance());
+    }
+    @ParameterizedTest @ValueSource(strings = {"balance", "alipay", "wechat", "bank"})
+    void wrongPasswordCommitsNothing(String method) {
+        assertThrows(RuntimeException.class, () -> orders.payOrder(orderId, buyer.intValue(), payment(method, "000000")));
+        assertEquals("PENDING", status()); assertEquals(2, stock()); assertEquals(0, ledger()); assertEquals(new BigDecimal("100.00"), balance());
+    }
+    @Test void repeatedExpiryNeverInflatesStock() {
+        jdbc.update("UPDATE orders SET expire_time=DATE_SUB(NOW(),INTERVAL 1 MINUTE) WHERE id=?", orderId);
+        expiry.closeExpiredOrders(); expiry.closeExpiredOrders();
+        assertEquals("EXPIRED", status()); assertEquals(2, stock()); assertEquals(0, ledger());
+        assertThrows(RuntimeException.class, () -> orders.payOrder(orderId, buyer.intValue(), payment("balance", "123456")));
+    }
+    @Test void concurrentPaymentsHaveOneWinnerAndOneLedgerRow() throws Exception {
+        java.util.concurrent.ExecutorService pool = java.util.concurrent.Executors.newFixedThreadPool(2);
+        java.util.concurrent.CountDownLatch start = new java.util.concurrent.CountDownLatch(1);
+        java.util.concurrent.Callable<Boolean> attempt = () -> {
+            start.await();
+            try {
+                orders.payOrder(orderId, buyer.intValue(), payment("balance", "123456"));
+                return true;
+            } catch (RuntimeException refused) {
+                if (!refused.getMessage().contains("not pending")) throw refused;
+                return false;
+            }
+        };
+        try {
+            var first = pool.submit(attempt); var second = pool.submit(attempt); start.countDown();
+            assertNotEquals(first.get(15, java.util.concurrent.TimeUnit.SECONDS), second.get(15, java.util.concurrent.TimeUnit.SECONDS));
+            assertEquals("PAID", status()); assertEquals(1, ledger()); assertEquals(1, stock());
+            assertEquals(new BigDecimal("70.00"), balance());
+        } finally {
+            pool.shutdownNow(); assertTrue(pool.awaitTermination(10, java.util.concurrent.TimeUnit.SECONDS));
+        }
+    }
+
+}
