@@ -0,0 +1,108 @@
+package lut.cn.c2cplatform;
+
+import lut.cn.c2cplatform.dto.ReviewRequest;
+import lut.cn.c2cplatform.entity.*;
+import lut.cn.c2cplatform.mapper.*;
+import lut.cn.c2cplatform.service.CreditScoreService;
+import lut.cn.c2cplatform.service.HybridRecommendationService;
+import lut.cn.c2cplatform.service.impl.ReviewServiceImpl;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.test.util.ReflectionTestUtils;
+import java.math.BigDecimal;
+import java.util.List;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class ReviewAcceptanceTest {
+    ReviewMapper reviews = mock(ReviewMapper.class);
+    OrderMapper orders = mock(OrderMapper.class);
+    OrderItemMapper items = mock(OrderItemMapper.class);
+    ProductMapper products = mock(ProductMapper.class);
+    UserMapper users = mock(UserMapper.class);
+    CreditScoreService credit = mock(CreditScoreService.class);
+    HybridRecommendationService recommendation = mock(HybridRecommendationService.class);
+    ReviewServiceImpl service = new ReviewServiceImpl();
+    Order order; ReviewRequest request;
+    @BeforeEach
+    void setup() {
+        ReflectionTestUtils.setField(service, "reviewMapper", reviews);
+        ReflectionTestUtils.setField(service, "orderMapper", orders);
+        ReflectionTestUtils.setField(service, "orderItemMapper", items);
+        ReflectionTestUtils.setField(service, "productMapper", products);
+        ReflectionTestUtils.setField(service, "userMapper", users);
+        ReflectionTestUtils.setField(service, "creditScoreService", credit);
+        ReflectionTestUtils.setField(service, "hybridRecommendationService", recommendation);
+        order = new Order(); order.setId(50); order.setUserId(1); order.setStatus("COMPLETED");
+        when(orders.findById(50)).thenReturn(order);
+        request = new ReviewRequest(); request.setOrderId(50); request.setProductRating(5); request.setSellerRating(4);
+        OrderItem item = new OrderItem(); item.setProductId(7); item.setQuantity(1); item.setPrice(BigDecimal.TEN);
+        when(items.findByOrderId(50)).thenReturn(List.of(item));
+        Product p = new Product(); p.setId(7L); p.setUserId(2L); p.setName("Book");
+        when(products.selectById(7L)).thenReturn(p);
+    }
+    @ParameterizedTest @ValueSource(strings = {"PENDING", "PAID", "CANCELED", "EXPIRED"})
+    void nonCompletedOrderCannotBeReviewed(String state) {
+        order.setStatus(state);
+        assertThrows(RuntimeException.class, () -> service.createReview(1, request));
+        verify(reviews, never()).insert(any());
+    }
+    @ParameterizedTest @ValueSource(strings = {"DELIVERED", "COMPLETED"})
+    void preservesBothUploadedCompletedStatesAndRefusesSecondReview(String state) {
+        order.setStatus(state); request.setComment("Good"); request.setReviewImages(List.of("https://example.test/a.png")); request.setIsAnonymous(true);
+        Review saved = service.createReview(1, request);
+        assertEquals(5, saved.getProductRating()); assertEquals(4, saved.getSellerRating());
+        assertEquals(7L, saved.getProductId()); assertEquals(2, saved.getSellerId());
+        assertEquals("https://example.test/a.png", saved.getReviewImages()); assertTrue(saved.getIsAnonymous());
+        verify(credit).updateCreditScore(2L); verify(recommendation).updatePopularity(7L, "review");
+        when(reviews.selectByOrderId(50)).thenReturn(saved);
+        assertThrows(RuntimeException.class, () -> service.createReview(1, request));
+        verify(reviews, times(1)).insert(any());
+    }
+    @Test
+    void rejectsWrongBuyerMissingOrderAndInvalidRatings() {
+        assertThrows(RuntimeException.class, () -> service.createReview(99, request));
+        for (int bad : new int[]{0, 6}) {
+            request.setProductRating(bad); assertThrows(RuntimeException.class, () -> service.createReview(1, request));
+        }
+        request.setProductRating(5);
+        for (int bad : new int[]{0, 6}) {
+            request.setSellerRating(bad); assertThrows(RuntimeException.class, () -> service.createReview(1, request));
+        }
+        when(orders.findById(50)).thenReturn(null);
+        assertThrows(RuntimeException.class, () -> service.createReview(1, request));
+    }
+    @Test
+    void rejectsMissingPurchasedItemsAndProduct() {
+        when(items.findByOrderId(50)).thenReturn(List.of());
+        assertThrows(RuntimeException.class, () -> service.createReview(1, request));
+        OrderItem item = new OrderItem(); item.setProductId(7); when(items.findByOrderId(50)).thenReturn(List.of(item));
+        when(products.selectById(7L)).thenReturn(null);
+        assertThrows(RuntimeException.class, () -> service.createReview(1, request));
+    }
+    @Test
+    void publicAnonymousAndNamedReviewsUseUploadedResponseContract() {
+        Review saved = service.createReview(1, request);
+        when(reviews.selectByProductId(7L)).thenReturn(List.of(saved));
+        User buyer = new User(); buyer.setDisplayName("Alice"); buyer.setAvatarUrl("avatar");
+        when(users.selectById(1L)).thenReturn(buyer);
+        var response = service.getProductReviews(7L).get(0);
+        assertEquals(1, response.getBuyerId()); assertEquals("Alice", response.getBuyerName()); assertEquals("Book", response.getProductName());
+        assertTrue(response.getReviewImages().isEmpty());
+        saved.setIsAnonymous(true); saved.setReviewImages("a,b");
+        response = service.getProductReviews(7L).get(0);
+        assertNull(response.getBuyerId()); assertEquals("匿名用户", response.getBuyerName()); assertEquals(List.of("a", "b"), response.getReviewImages());
+    }
+    @Test
+    void listsAndReviewChecksUseExistingMapperContracts() {
+        assertFalse(service.hasReviewed(50)); when(reviews.selectByOrderId(50)).thenReturn(new Review());
+        assertTrue(service.hasReviewed(50));
+        service.getSellerReviews(2); service.getBuyerReviews(1);
+        verify(reviews).selectBySellerId(2); verify(reviews).selectByBuyerId(1);
+        assertEquals(0.0, service.getProductAverageRating(7L));
+        when(reviews.getAverageProductRating(7L)).thenReturn(4.5);
+        assertEquals(4.5, service.getProductAverageRating(7L));
+    }
+}
