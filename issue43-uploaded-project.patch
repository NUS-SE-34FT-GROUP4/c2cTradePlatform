+package lut.cn.c2cplatform;
+
+import lut.cn.c2cplatform.dto.PaymentRequest;
+import lut.cn.c2cplatform.entity.*;
+import lut.cn.c2cplatform.mapper.*;
+import lut.cn.c2cplatform.service.CreditScoreService;
+import lut.cn.c2cplatform.service.HybridRecommendationService;
+import lut.cn.c2cplatform.service.impl.OrderServiceImpl;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.security.crypto.bcrypt.BCrypt;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import java.math.BigDecimal;
+import java.util.Date;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+class OrderAcceptanceTest {
+    OrderMapper orders = mock(OrderMapper.class);
+    OrderItemMapper items = mock(OrderItemMapper.class);
+    TransactionMapper transactions = mock(TransactionMapper.class);
+    CartItemMapper carts = mock(CartItemMapper.class);
+    ProductMapper products = mock(ProductMapper.class);
+    UserMapper users = mock(UserMapper.class);
+    BargainActivityMapper bargains = mock(BargainActivityMapper.class);
+    CreditScoreService credit = mock(CreditScoreService.class);
+    HybridRecommendationService recommendation = mock(HybridRecommendationService.class);
+    OrderServiceImpl service = new OrderServiceImpl();
+    Order order;
+    OrderItem line;
+    Product product;
+    User buyer, seller;
+
+    @BeforeEach
+    void setup() {
+        ReflectionTestUtils.setField(service, "orderMapper", orders);
+        ReflectionTestUtils.setField(service, "orderItemMapper", items);
+        ReflectionTestUtils.setField(service, "transactionMapper", transactions);
+        ReflectionTestUtils.setField(service, "cartItemMapper", carts);
+        ReflectionTestUtils.setField(service, "productMapper", products);
+        ReflectionTestUtils.setField(service, "userMapper", users);
+        ReflectionTestUtils.setField(service, "bargainActivityMapper", bargains);
+        ReflectionTestUtils.setField(service, "creditScoreService", credit);
+        ReflectionTestUtils.setField(service, "hybridRecommendationService", recommendation);
+        order = new Order(); order.setId(50); order.setUserId(1); order.setStatus("PENDING");
+        order.setTotalAmount(new BigDecimal("30.00"));
+        line = new OrderItem(); line.setProductId(7); line.setQuantity(1); line.setPrice(new BigDecimal("30.00")); line.setFromCart(false);
+        product = new Product(); product.setId(7L); product.setUserId(2L); product.setName("Book"); product.setStock(2); product.setPrice(new BigDecimal("30.00"));
+        buyer = new User(); buyer.setId(1L); buyer.setBalance(new BigDecimal("100.00")); buyer.setPaymentPasswordHash(BCrypt.hashpw("123456", BCrypt.gensalt(4)));
+        seller = new User(); seller.setId(2L); seller.setBalance(BigDecimal.ZERO);
+        when(orders.findByIdForUpdate(50)).thenReturn(order);
+        when(items.findByOrderId(50)).thenReturn(List.of(line));
+        when(products.selectByIdForUpdate(7L)).thenReturn(product);
+        when(products.selectById(7L)).thenReturn(product);
+        when(products.decreaseStock(7L, 1)).thenReturn(1);
+        when(users.selectById(1L)).thenReturn(buyer);
+        when(users.selectById(2L)).thenReturn(seller);
+        doAnswer(inv -> { ((Order) inv.getArgument(0)).setId(50); return null; }).when(orders).insert(any());
+        when(orders.findByUserId(1)).thenReturn(List.of());
+    }
+    private PaymentRequest payment(String method, String password) {
+        PaymentRequest r = new PaymentRequest(); r.setPaymentMethod(method); r.setPassword(password); return r;
+    }
+    @ParameterizedTest @ValueSource(strings = {"balance", "alipay", "wechat", "bank"})
+    void paysOnceAndRecordsSelectedMethod(String method) {
+        assertEquals("PAID", service.payOrder(50, 1, payment(method, "123456")).getStatus());
+        assertEquals(new BigDecimal("balance".equals(method) ? "70.00" : "100.00"), buyer.getBalance());
+        verify(products).decreaseStock(7L, 1);
+        verify(transactions).insert(argThat(t -> "SUCCESS".equals(t.getStatus()) && method.equals(t.getPaymentMethod()) && t.getAmount().compareTo(new BigDecimal("30")) == 0));
+        assertThrows(RuntimeException.class, () -> service.payOrder(50, 1, payment(method, "123456")));
+        verify(transactions, times(1)).insert(any());
+    }
+    @Test
+    void insufficientBalanceIsRefused() {
+        buyer.setBalance(new BigDecimal("5.00"));
+        RuntimeException e = assertThrows(RuntimeException.class, () -> service.payOrder(50, 1, payment("balance", "123456")));
+        assertTrue(e.getMessage().contains("余额不足"));
+        assertEquals(new BigDecimal("5.00"), buyer.getBalance());
+        verify(transactions, never()).insert(any()); verify(orders, never()).updateStatus(any());
+        // Database rollback of the preceding stock update is verified by TransactionAcceptanceIT.
+    }
+    @ParameterizedTest @ValueSource(strings = {"balance", "alipay", "wechat", "bank"})
+    void wrongPasswordTouchesNoStockOrLedger(String method) {
+        assertThrows(RuntimeException.class, () -> service.payOrder(50, 1, payment(method, "000000")));
+        verify(products, never()).decreaseStock(anyLong(), anyInt());
+        verify(users, never()).update(any()); verify(transactions, never()).insert(any());
+    }
+    @Test
+    void paymentRejectsInvalidPasswordMissingUserAndWrongOwner() {
+        assertThrows(RuntimeException.class, () -> service.payOrder(50, 99, payment("balance", "123456")));
+        for (String bad : new String[]{null, "12345", "abcdef"}) {
+            assertThrows(RuntimeException.class, () -> service.payOrder(50, 1, payment("balance", bad)));
+        }
+        buyer.setPaymentPasswordHash(null);
+        assertThrows(RuntimeException.class, () -> service.payOrder(50, 1, payment("balance", "123456")));
+        when(users.selectById(1L)).thenReturn(null);
+        assertThrows(RuntimeException.class, () -> service.payOrder(50, 1, payment("balance", "123456")));
+    }
+    @Test
+    void unavailableStockAndFailedDeductionAreRefused() {
+        product.setStock(0);
+        assertThrows(RuntimeException.class, () -> service.payOrder(50, 1, payment("balance", "123456")));
+        product.setStock(2); when(products.decreaseStock(7L, 1)).thenReturn(0);
+        assertThrows(RuntimeException.class, () -> service.payOrder(50, 1, payment("balance", "123456")));
+        when(products.selectByIdForUpdate(7L)).thenReturn(null);
+        assertThrows(RuntimeException.class, () -> service.payOrder(50, 1, payment("balance", "123456")));
+    }
+    @Test
+    void soldOutPaymentEndsBargainsAndRemovesPurchasedCartLine() {
+        line.setFromCart(true);
+        Product sold = new Product(); sold.setStock(0);
+        when(products.selectById(7L)).thenReturn(sold);
+        service.payOrder(50, 1, payment("balance", "123456"));
+        verify(bargains).markAllActiveAsFailed(7L);
+        verify(carts).deleteByUserIdAndProductId(1L, 7L);
+    }
+    @Test
+    void invalidTransitionsAreRefused() {
+        for (String state : List.of("PENDING", "CANCELED", "EXPIRED", "COMPLETED")) {
+            order.setStatus(state); assertThrows(RuntimeException.class, () -> service.confirmOrder(50));
+        }
+        for (String state : List.of("PAID", "DELIVERED", "EXPIRED", "COMPLETED")) {
+            order.setStatus(state); assertThrows(RuntimeException.class, () -> service.cancelOrder(50));
+        }
+        verify(users, never()).update(any()); verify(orders, never()).updateStatus(any());
+    }
+    @ParameterizedTest @ValueSource(strings = {"PAID", "DELIVERED"})
+    void receiptCreditsSellerOnlyOnce(String state) {
+        order.setStatus(state);
+        assertEquals("COMPLETED", service.confirmOrder(50).getStatus());
+        assertEquals(new BigDecimal("30.00"), seller.getBalance());
+        verify(credit).updateCreditScore(2L); verify(credit).updateCreditScore(1L);
+        assertThrows(RuntimeException.class, () -> service.confirmOrder(50));
+        verify(users, times(1)).update(seller);
+    }
+    @Test
+    void invalidSellerCreditIsRefused() {
+        order.setStatus("PAID"); line.setPrice(BigDecimal.ZERO);
+        assertThrows(RuntimeException.class, () -> service.confirmOrder(50));
+        line.setPrice(new BigDecimal("30.00")); seller.setBalance(new BigDecimal("9999999999999.99"));
+        assertThrows(RuntimeException.class, () -> service.confirmOrder(50));
+    }
+    @Test
+    void directAndBargainCheckoutDoNotDeductStock() {
+        Order direct = service.createOrderForProduct(1, 7L, 1);
+        assertEquals("PENDING", direct.getStatus()); assertEquals(new BigDecimal("30.00"), direct.getTotalAmount());
+        assertTrue(direct.getExpireTime().after(direct.getCreatedAt()));
+        Order bargained = service.createBargainOrder(1, 7L, 2, new BigDecimal("10.00"));
+        assertEquals(new BigDecimal("20.00"), bargained.getTotalAmount());
+        verify(products, never()).decreaseStock(anyLong(), anyInt());
+    }
+    @Test
+    void cartCheckoutKeepsLinesAndPricesWithoutDeductingStock() {
+        CartItem cart = new CartItem(); cart.setProductId(7L); cart.setQuantity(2);
+        when(carts.selectByUserId(1L)).thenReturn(List.of(cart));
+        assertEquals(new BigDecimal("60.00"), service.createOrderFromCart(1).getTotalAmount());
+        verify(items).insert(argThat(i -> Boolean.TRUE.equals(i.getFromCart()) && i.getQuantity() == 2));
+        verify(products, never()).decreaseStock(anyLong(), anyInt());
+        verify(carts, never()).deleteByUserId(anyLong());
+    }
+    @Test
+    void checkoutRejectsMissingProductsStockAndEmptyCart() {
+        when(carts.selectByUserId(1L)).thenReturn(List.of());
+        assertThrows(RuntimeException.class, () -> service.createOrderFromCart(1));
+        when(products.selectByIdForUpdate(7L)).thenReturn(null);
+        assertThrows(RuntimeException.class, () -> service.createOrderForProduct(1, 7L, 1));
+        assertThrows(RuntimeException.class, () -> service.createBargainOrder(1, 7L, 1, BigDecimal.ONE));
+        product.setStock(0); when(products.selectByIdForUpdate(7L)).thenReturn(product);
+        assertThrows(RuntimeException.class, () -> service.createOrderForProduct(1, 7L, 1));
+        assertThrows(RuntimeException.class, () -> service.createBargainOrder(1, 7L, 1, BigDecimal.ONE));
+        CartItem cart = new CartItem(); cart.setProductId(7L); cart.setQuantity(1);
+        when(carts.selectByUserId(1L)).thenReturn(List.of(cart));
+        assertThrows(RuntimeException.class, () -> service.createOrderFromCart(1));
+        when(products.selectByIdForUpdate(7L)).thenReturn(null);
+        assertThrows(RuntimeException.class, () -> service.createOrderFromCart(1));
+    }
+    @Test
+    void cancellationRestoresMissingCartAndLeavesStockAlone() {
+        line.setFromCart(true);
+        assertEquals("CANCELED", service.cancelOrder(50).getStatus());
+        verify(carts).insert(argThat(c -> c.getUserId() == 1L && c.getProductId() == 7L && c.getQuantity() == 1));
+        verify(products, never()).update(any());
+    }
+    @Test
+    void existingCartAndReadMethodsUseUploadedContracts() {
+        line.setFromCart(true); CartItem cart = new CartItem(); cart.setQuantity(2);
+        when(carts.selectByUserIdAndProductId(1L, 7L)).thenReturn(cart);
+        service.cancelOrder(50); assertEquals(3, cart.getQuantity());
+        when(orders.findById(50)).thenReturn(order);
+        assertSame(order, service.getOrderById(50));
+        service.getUserOrders(1); service.getSellerOrders(2); verify(orders).findBySellerId(2);
+    }
+    @Test
+    void checkoutCancelsOldPendingOrdersBeforeCreatingNewOnes() {
+        order.setExpireTime(new Date(0)); when(orders.findByUserId(1)).thenReturn(List.of(order));
+        service.createOrderForProduct(1, 7L, 1);
+        assertEquals("CANCELED", order.getStatus());
+    }
+    @Test
+    void missingOrdersAreRefused() {
+        when(orders.findByIdForUpdate(50)).thenReturn(null);
+        assertThrows(RuntimeException.class, () -> service.payOrder(50, 1, payment("balance", "123456")));
+        assertThrows(RuntimeException.class, () -> service.confirmOrder(50));
+        assertThrows(RuntimeException.class, () -> service.cancelOrder(50));
+    }
+}
