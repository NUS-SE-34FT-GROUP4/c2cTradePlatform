@@ -0,0 +1,53 @@
+package lut.cn.c2cplatform;
+
+import lut.cn.c2cplatform.entity.Order;
+import lut.cn.c2cplatform.mapper.OrderMapper;
+import lut.cn.c2cplatform.scheduled.OrderExpireTask;
+import org.junit.jupiter.api.Test;
+import org.springframework.test.util.ReflectionTestUtils;
+import java.util.Date;
+import java.util.List;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class OrderExpiryAcceptanceTest {
+    @Test
+    void expiresPendingOnceWithoutInventingStockOrDuplicatingCart() {
+        OrderMapper mapper = mock(OrderMapper.class);
+        OrderExpireTask task = new OrderExpireTask(); ReflectionTestUtils.setField(task, "orderMapper", mapper);
+        Order o = order("PENDING");
+        when(mapper.findExpiredOrders()).thenReturn(List.of(o));
+        when(mapper.findByIdForUpdate(50)).thenReturn(o);
+        task.closeExpiredOrders(); assertEquals("EXPIRED", o.getStatus());
+        task.closeExpiredOrders(); verify(mapper, times(1)).updateStatus(o);
+    }
+    private Order order(String state) {
+        Order o = new Order(); o.setId(50); o.setStatus(state); o.setExpireTime(new Date(0)); return o;
+    }
+    @Test
+    void rechecksCandidatesAfterPaymentWinsAndSkipsNonExpiredRows() {
+        OrderMapper mapper = mock(OrderMapper.class); OrderExpireTask task = new OrderExpireTask();
+        ReflectionTestUtils.setField(task, "orderMapper", mapper);
+        when(mapper.findExpiredOrders()).thenReturn(List.of(order("PENDING")));
+        for (String state : List.of("PAID", "COMPLETED", "EXPIRED", "CANCELED")) {
+            Order locked = order(state); when(mapper.findByIdForUpdate(50)).thenReturn(locked);
+            task.closeExpiredOrders(); assertEquals(state, locked.getStatus());
+        }
+        Order future = order("PENDING"); future.setExpireTime(new Date(Long.MAX_VALUE));
+        when(mapper.findByIdForUpdate(50)).thenReturn(future); task.closeExpiredOrders();
+        future.setExpireTime(null); task.closeExpiredOrders();
+        when(mapper.findByIdForUpdate(50)).thenReturn(null); task.closeExpiredOrders();
+        verify(mapper, never()).updateStatus(any());
+    }
+    @Test
+    void emptySweepIsNoopAndWriteFailurePropagatesForRollback() {
+        OrderMapper mapper = mock(OrderMapper.class); OrderExpireTask task = new OrderExpireTask();
+        ReflectionTestUtils.setField(task, "orderMapper", mapper);
+        when(mapper.findExpiredOrders()).thenReturn(List.of()); task.closeExpiredOrders();
+        verify(mapper, never()).findByIdForUpdate(anyInt());
+        Order o = order("PENDING"); when(mapper.findExpiredOrders()).thenReturn(List.of(o));
+        when(mapper.findByIdForUpdate(50)).thenReturn(o);
+        doThrow(new RuntimeException("database failure")).when(mapper).updateStatus(o);
+        assertThrows(RuntimeException.class, task::closeExpiredOrders);
+    }
+}
diff --git a/src/test/java/lut/cn/c2cplatform/ReviewAcceptanceTest.java b/src/test/java/lut/cn/c2cplatform/ReviewAcceptanceTest.java
