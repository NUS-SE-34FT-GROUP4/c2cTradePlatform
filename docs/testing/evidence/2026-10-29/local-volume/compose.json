{
  "name": "cui-5006-volume-1029",
  "services": {
    "mysql": {
      "image": "mysql:8.0.36",
      "environment": {
        "MYSQL_ROOT_PASSWORD": "${LOCAL_DB_PASSWORD}",
        "MYSQL_DATABASE": "trade",
        "MYSQL_USER": "tradeuser",
        "MYSQL_PASSWORD": "${LOCAL_DB_PASSWORD}"
      },
      "volumes": [
        "volume-mysql:/var/lib/mysql",
        "./source/init.sql:/docker-entrypoint-initdb.d/init.sql:ro"
      ],
      "mem_limit": "1g",
      "cpus": 1,
      "healthcheck": {
        "test": [
          "CMD",
          "mysqladmin",
          "ping",
          "-h",
          "localhost"
        ],
        "interval": "5s",
        "timeout": "3s",
        "retries": 30
      }
    },
    "redis": {
      "image": "redis:7.2",
      "mem_limit": "128m"
    },
    "elasticsearch": {
      "image": "docker.elastic.co/elasticsearch/elasticsearch:8.10.4",
      "environment": {
        "discovery.type": "single-node",
        "xpack.security.enabled": "false",
        "ES_JAVA_OPTS": "-Xms256m -Xmx256m"
      },
      "mem_limit": "1g",
      "cpus": 1,
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl -fsS http://localhost:9200/_cluster/health?wait_for_status=yellow"
        ],
        "interval": "5s",
        "timeout": "3s",
        "retries": 40
      }
    },
    "minio": {
      "image": "ass-wp10-minio:2025-04-22",
      "command": [
        "server",
        "/data",
        "--console-address",
        ":9001"
      ],
      "environment": {
        "MINIO_ROOT_USER": "localvolume",
        "MINIO_ROOT_PASSWORD": "${LOCAL_MINIO_PASSWORD}"
      },
      "mem_limit": "256m",
      "volumes": [
        "volume-minio:/data"
      ]
    },
    "backend": {
      "image": "cui-5006-volume-backend:e73fde73",
      "environment": {
        "SPRING_PROFILES_ACTIVE": "docker",
        "APP_VERSION": "e73fde73b42956411c95dc7145da6eb29dec778b-local-arm64-volume",
        "SPRING_DATASOURCE_URL": "jdbc:mysql://mysql:3306/trade?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8",
        "SPRING_DATASOURCE_USERNAME": "tradeuser",
        "SPRING_DATASOURCE_PASSWORD": "${LOCAL_DB_PASSWORD}",
        "SPRING_DATA_REDIS_HOST": "redis",
        "ELASTICSEARCH_URIS": "http://elasticsearch:9200",
        "MINIO_ENDPOINT": "http://minio:9000",
        "MINIO_PUBLIC_ENDPOINT": "http://127.0.0.1:19000",
        "MINIO_ACCESS_KEY": "localvolume",
        "MINIO_SECRET_KEY": "${LOCAL_MINIO_PASSWORD}",
        "JWT_SECRET": "${LOCAL_JWT_SECRET}"
      },
      "ports": [
        "127.0.0.1:18086:8080"
      ],
      "mem_limit": "1g",
      "cpus": 2,
      "depends_on": {
        "mysql": {
          "condition": "service_healthy"
        },
        "redis": {
          "condition": "service_started"
        },
        "elasticsearch": {
          "condition": "service_healthy"
        },
        "minio": {
          "condition": "service_started"
        }
      }
    }
  },
  "volumes": {
    "volume-mysql": {},
    "volume-minio": {}
  }
}