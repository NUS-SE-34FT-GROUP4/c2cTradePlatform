<mxfile host="drawio"><diagram name="Pay — design sequence" id="d1"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="0" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Pay for an Order — design sequence diagram" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#2B2F36;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1376" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Classes and methods as in the repository. Transition strategies: S0 controller · S1 mappers and conditional SQL · S2 one transaction · S3 guarded status change" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=bottom;fontSize=11;fontColor=#5B6270;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1376" height="18" as="geometry"/></mxCell><mxCell id="c5" value="«actor»&#xa;Buyer" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB2C0;fontSize=11;fontColor=#2B2F36;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="43" y="80" width="144" height="42" as="geometry"/></mxCell><mxCell id="c6" value="OrderController" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB2C0;fontSize=11;fontColor=#2B2F36;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="215" y="80" width="144" height="42" as="geometry"/></mxCell><mxCell id="c7" value="«@Transactional»&#xa;PaymentService" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB2C0;fontSize=11;fontColor=#2B2F36;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="387" y="80" width="144" height="42" as="geometry"/></mxCell><mxCell id="c8" value="OrderMapper" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB2C0;fontSize=11;fontColor=#2B2F36;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="559" y="80" width="144" height="42" as="geometry"/></mxCell><mxCell id="c9" value="«interface»&#xa;PaymentStrategy" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB2C0;fontSize=11;fontColor=#2B2F36;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="731" y="80" width="144" height="42" as="geometry"/></mxCell><mxCell id="c10" value="WalletService" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB2C0;fontSize=11;fontColor=#2B2F36;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="903" y="80" width="144" height="42" as="geometry"/></mxCell><mxCell id="c11" value="TransactionMapper" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB2C0;fontSize=11;fontColor=#2B2F36;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1075" y="80" width="144" height="42" as="geometry"/></mxCell><mxCell id="c12" value="ProductMapper" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB2C0;fontSize=11;fontColor=#2B2F36;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1247" y="80" width="144" height="42" as="geometry"/></mxCell><mxCell id="c13" value="1. POST /api/orders/{id}/pay  {method, paymentPassword}" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="119" y="132" width="164" height="14" as="geometry"/></mxCell><mxCell id="c14" style="endArrow=block;endFill=1;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="150" as="sourcePoint"/><mxPoint x="287" y="150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="2. pay(buyerId, orderId, method, paymentPassword)" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="291" y="166" width="164" height="14" as="geometry"/></mxCell><mxCell id="c16" style="endArrow=block;endFill=1;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="287" y="184" as="sourcePoint"/><mxPoint x="459" y="184" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="3. selectById(orderId)" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="463" y="200" width="164" height="14" as="geometry"/></mxCell><mxCell id="c18" style="endArrow=block;endFill=1;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="459" y="218" as="sourcePoint"/><mxPoint x="631" y="218" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="order [PENDING_PAYMENT]" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#6E8FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="463" y="234" width="164" height="14" as="geometry"/></mxCell><mxCell id="c20" style="endArrow=open;endFill=0;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="631" y="252" as="sourcePoint"/><mxPoint x="459" y="252" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="4. buyer owns the order, status is PENDING_PAYMENT&#xa;strategy := strategies.get(method)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="497" y="284" width="250" height="32" as="geometry"/></mxCell><mxCell id="c22" style="endArrow=block;endFill=1;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="459" y="286" as="sourcePoint"/><mxPoint x="459" y="314" as="targetPoint"/><Array as="points"><mxPoint x="489" y="286"/><mxPoint x="489" y="314"/></Array></mxGeometry></mxCell><mxCell id="c23" value="5. transition(id, PENDING_PAYMENT → PAID, method)&#xa;UPDATE … WHERE id = ? AND status = &#x27;PENDING_PAYMENT&#x27;" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="463" y="336" width="164" height="28" as="geometry"/></mxCell><mxCell id="c24" style="endArrow=block;endFill=1;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="459" y="368" as="sourcePoint"/><mxPoint x="631" y="368" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="1 row   (0 rows → refused before any money moves)" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#6BA87F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="463" y="384" width="164" height="14" as="geometry"/></mxCell><mxCell id="c26" style="endArrow=open;endFill=0;html=1;strokeColor=#6BA87F;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="631" y="402" as="sourcePoint"/><mxPoint x="459" y="402" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="6. settle(order, buyerId, paymentPassword)" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="463" y="418" width="336" height="14" as="geometry"/></mxCell><mxCell id="c28" style="endArrow=block;endFill=1;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="459" y="436" as="sourcePoint"/><mxPoint x="803" y="436" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="7. pay(buyerId, paymentPassword, totalAmount)   — BalancePaymentStrategy" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="807" y="478" width="164" height="14" as="geometry"/></mxCell><mxCell id="c30" style="endArrow=block;endFill=1;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="803" y="496" as="sourcePoint"/><mxPoint x="975" y="496" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="8. verifyPaymentPassword&#xa;lockBalance: SELECT … FOR UPDATE&#xa;balance ≥ total → updateBalance(balance − total)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1013" y="528" width="250" height="46" as="geometry"/></mxCell><mxCell id="c32" style="endArrow=block;endFill=1;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="975" y="530" as="sourcePoint"/><mxPoint x="975" y="572" as="targetPoint"/><Array as="points"><mxPoint x="1005" y="530"/><mxPoint x="1005" y="572"/></Array></mxGeometry></mxCell><mxCell id="c33" value="7′. verifyPaymentPassword(buyerId, paymentPassword)   — SimulatedGatewayPaymentStrategy" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="807" y="620" width="164" height="14" as="geometry"/></mxCell><mxCell id="c34" style="endArrow=block;endFill=1;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="803" y="638" as="sourcePoint"/><mxPoint x="975" y="638" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="" style="rounded=0;fillColor=none;strokeColor=#AAB2C0;dashed=1;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="26" y="458" width="1404" height="200" as="geometry"/></mxCell><mxCell id="c36" value="alt" style="shape=card;size=8;direction=south;fillColor=#FFFFFF;strokeColor=#AAB2C0;fontSize=11;fontStyle=1;fontColor=#2B2F36;" vertex="1" parent="1"><mxGeometry x="26" y="458" width="44" height="20" as="geometry"/></mxCell><mxCell id="c37" value="[method = balance]" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5B6270;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="76" y="460" width="400" height="16" as="geometry"/></mxCell><mxCell id="c38" style="endArrow=none;endFill=0;html=1;strokeColor=#AAB2C0;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="602" as="sourcePoint"/><mxPoint x="1430" y="602" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="[method = alipay · wechat · bank · paynow]" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5B6270;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="34" y="604" width="400" height="16" as="geometry"/></mxCell><mxCell id="c40" value="9. insert(PAYMENT, totalAmount)   — ledger row, never updated" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="463" y="674" width="680" height="14" as="geometry"/></mxCell><mxCell id="c41" style="endArrow=block;endFill=1;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="459" y="692" as="sourcePoint"/><mxPoint x="1147" y="692" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="10. per item: releaseStock(q) then decreaseStock(q)   — reservation becomes deduction" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="463" y="708" width="852" height="14" as="geometry"/></mxCell><mxCell id="c43" style="endArrow=block;endFill=1;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="459" y="726" as="sourcePoint"/><mxPoint x="1319" y="726" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="11. publishEvent(OrderStateChangedEvent)&#xa;→ notifications sent after commit" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="497" y="758" width="250" height="32" as="geometry"/></mxCell><mxCell id="c45" style="endArrow=block;endFill=1;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="459" y="760" as="sourcePoint"/><mxPoint x="459" y="788" as="targetPoint"/><Array as="points"><mxPoint x="489" y="760"/><mxPoint x="489" y="788"/></Array></mxGeometry></mxCell><mxCell id="c46" value="order [PAID]" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#6E8FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="291" y="810" width="164" height="14" as="geometry"/></mxCell><mxCell id="c47" style="endArrow=open;endFill=0;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="459" y="828" as="sourcePoint"/><mxPoint x="287" y="828" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c48" value="200 OK" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#6E8FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="119" y="844" width="164" height="14" as="geometry"/></mxCell><mxCell id="c49" style="endArrow=open;endFill=0;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="287" y="862" as="sourcePoint"/><mxPoint x="115" y="862" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" style="endArrow=none;endFill=0;html=1;strokeColor=#AAB2C0;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="122" as="sourcePoint"/><mxPoint x="115" y="896" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c51" style="endArrow=none;endFill=0;html=1;strokeColor=#AAB2C0;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="287" y="122" as="sourcePoint"/><mxPoint x="287" y="896" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c52" style="endArrow=none;endFill=0;html=1;strokeColor=#AAB2C0;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="459" y="122" as="sourcePoint"/><mxPoint x="459" y="896" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" style="endArrow=none;endFill=0;html=1;strokeColor=#AAB2C0;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="631" y="122" as="sourcePoint"/><mxPoint x="631" y="896" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c54" style="endArrow=none;endFill=0;html=1;strokeColor=#AAB2C0;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="803" y="122" as="sourcePoint"/><mxPoint x="803" y="896" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c55" style="endArrow=none;endFill=0;html=1;strokeColor=#AAB2C0;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="975" y="122" as="sourcePoint"/><mxPoint x="975" y="896" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c56" style="endArrow=none;endFill=0;html=1;strokeColor=#AAB2C0;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1147" y="122" as="sourcePoint"/><mxPoint x="1147" y="896" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c57" style="endArrow=none;endFill=0;html=1;strokeColor=#AAB2C0;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1319" y="122" as="sourcePoint"/><mxPoint x="1319" y="896" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c58" value="&lt;b&gt;Exception flows&lt;/b&gt; — wrong payment password (&lt;code&gt;PaymentPasswordException&lt;/code&gt;) or balance too low (&lt;code&gt;InsufficientBalanceException&lt;/code&gt;) throws inside the transaction, so step 5 rolls back with everything else: the order stays PENDING_PAYMENT and no money or stock moves. If step 5 changes 0 rows (already paid, cancelled or expired), the request is refused before step 6." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FBE9E7;strokeColor=#C1705B;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="906" width="1376" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>