<mxfile host="app.diagrams.net"><diagram name="Pay for an order" id="pay"><mxGraphModel dx="1300" dy="900" grid="0" page="1" pageWidth="1340" pageHeight="690" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Analysis model" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="300" height="24" as="geometry"/></mxCell><mxCell id="t2" value="Design model — every class below exists in the repository" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="520" y="18" width="760" height="24" as="geometry"/></mxCell><mxCell id="an_buyer" value="Buyer" style="swimlane;html=1;fontSize=12;fontStyle=1;startSize=26;fillColor=#F5F5F5;strokeColor=#9E9E9E;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="170" height="50" as="geometry"/></mxCell><mxCell id="an_buyer_b" value="pays for an order" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="an_buyer"><mxGeometry y="26" width="170" height="24" as="geometry"/></mxCell><mxCell id="an_order" value="Order" style="swimlane;html=1;fontSize=12;fontStyle=1;startSize=26;fillColor=#F5F5F5;strokeColor=#9E9E9E;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="170" height="82" as="geometry"/></mxCell><mxCell id="an_order_b" value="total amount&#10;status&#10;items" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="an_order"><mxGeometry y="26" width="170" height="56" as="geometry"/></mxCell><mxCell id="an_pay" value="Payment" style="swimlane;html=1;fontSize=12;fontStyle=1;startSize=26;fillColor=#F5F5F5;strokeColor=#9E9E9E;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="268" width="170" height="82" as="geometry"/></mxCell><mxCell id="an_pay_b" value="method · amount&#10;take() · release()&#10;refund()" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="an_pay"><mxGeometry y="26" width="170" height="56" as="geometry"/></mxCell><mxCell id="an_wallet" value="Wallet" style="swimlane;html=1;fontSize=12;fontStyle=1;startSize=26;fillColor=#F5F5F5;strokeColor=#9E9E9E;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="170" height="66" as="geometry"/></mxCell><mxCell id="an_wallet_b" value="balance&#10;held amount" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="an_wallet"><mxGeometry y="26" width="170" height="40" as="geometry"/></mxCell><mxCell id="an_listing" value="Listing" style="swimlane;html=1;fontSize=12;fontStyle=1;startSize=26;fillColor=#F5F5F5;strokeColor=#9E9E9E;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="390" width="170" height="66" as="geometry"/></mxCell><mxCell id="an_listing_b" value="stock&#10;reserved stock" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="an_listing"><mxGeometry y="26" width="170" height="40" as="geometry"/></mxCell><mxCell id="ea0" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#AAB2C0;endArrow=none;" edge="1" parent="1" source="an_buyer" target="an_order"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ea1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#AAB2C0;endArrow=none;" edge="1" parent="1" source="an_order" target="an_pay"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ea2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#AAB2C0;endArrow=none;" edge="1" parent="1" source="an_pay" target="an_wallet"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ea3" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#AAB2C0;endArrow=none;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="an_order" target="an_listing"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="an_note" value="One Payment object does it all: takes the money, holds it, releases it, refunds it — for every method." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontSize=11;fontColor=#8A8F9A;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="380" height="60" as="geometry"/></mxCell><mxCell id="d_ctrl" value="OrderController" style="swimlane;html=1;fontSize=12;fontStyle=1;startSize=26;fillColor=#E8F0FB;strokeColor=#6E8FC4;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="62" width="250" height="50" as="geometry"/></mxCell><mxCell id="d_ctrl_b" value="pay(orderId, method, password)" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="d_ctrl"><mxGeometry y="26" width="250" height="24" as="geometry"/></mxCell><mxCell id="d_svc" value="PaymentService" style="swimlane;html=1;fontSize=12;fontStyle=1;startSize=26;fillColor=#E4F2E8;strokeColor=#6BA87F;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="142" width="250" height="98" as="geometry"/></mxCell><mxCell id="d_svc_b" value="@Transactional pay(...)&#10;confirmReceipt(...) · refund(...)&#10;verifies, settles, records,&#10;advances the order" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="d_svc"><mxGeometry y="26" width="250" height="72" as="geometry"/></mxCell><mxCell id="d_wal" value="WalletService" style="swimlane;html=1;fontSize=12;fontStyle=1;startSize=26;fillColor=#E4F2E8;strokeColor=#6BA87F;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="290" width="250" height="66" as="geometry"/></mxCell><mxCell id="d_wal_b" value="pay() · credit() · debit()&#10;verifyPaymentPassword()" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="d_wal"><mxGeometry y="26" width="250" height="40" as="geometry"/></mxCell><mxCell id="d_state" value="OrderStateService" style="swimlane;html=1;fontSize=12;fontStyle=1;startSize=26;fillColor=#E4F2E8;strokeColor=#6BA87F;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="378" width="250" height="62" as="geometry"/></mxCell><mxCell id="d_state_b" value="apply(callerId, orderId, action)&#10;— cancel · ship · confirm receipt" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="d_state"><mxGeometry y="26" width="250" height="36" as="geometry"/></mxCell><mxCell id="d_map" value="OrderMapper · TransactionMapper · ProductMapper" style="swimlane;html=1;fontSize=12;fontStyle=1;startSize=26;fillColor=#F2E8F5;strokeColor=#9B7FB0;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="468" width="560" height="50" as="geometry"/></mxCell><mxCell id="d_map_b" value="rows, holds and the ledger" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="d_map"><mxGeometry y="26" width="560" height="24" as="geometry"/></mxCell><mxCell id="d_strat" value="«interface» PaymentStrategy" style="swimlane;html=1;fontSize=12;fontStyle=1;startSize=26;fillColor=#FDF1E3;strokeColor=#D9A05B;align=center;" vertex="1" parent="1"><mxGeometry x="890" y="142" width="230" height="98" as="geometry"/></mxCell><mxCell id="d_strat_b" value="method()&#10;settle(order, buyer, password)&#10;releaseToSeller(order, amount)&#10;refund(order, amount)" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="d_strat"><mxGeometry y="26" width="230" height="72" as="geometry"/></mxCell><mxCell id="d_bal" value="BalancePaymentStrategy" style="swimlane;html=1;fontSize=12;fontStyle=1;startSize=26;fillColor=#FDF1E3;strokeColor=#D9A05B;align=center;" vertex="1" parent="1"><mxGeometry x="890" y="290" width="230" height="50" as="geometry"/></mxCell><mxCell id="d_bal_b" value="settles inside the system" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="d_bal"><mxGeometry y="26" width="230" height="24" as="geometry"/></mxCell><mxCell id="d_sim" value="SimulatedGatewayPaymentStrategy" style="swimlane;html=1;fontSize=12;fontStyle=1;startSize=26;fillColor=#FDF1E3;strokeColor=#D9A05B;align=center;" vertex="1" parent="1"><mxGeometry x="890" y="370" width="230" height="66" as="geometry"/></mxCell><mxCell id="d_sim_b" value="Alipay · WeChat · Bank · PayNow&#10;settles outside the system" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="d_sim"><mxGeometry y="26" width="230" height="40" as="geometry"/></mxCell><mxCell id="ed1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#AAB2C0;endArrow=block;" edge="1" parent="1" source="d_ctrl" target="d_svc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#AAB2C0;endArrow=open;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d_svc" target="d_strat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed3" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#AAB2C0;endArrow=block;endFill=0;exitX=0;exitY=0.5;entryX=0.2;entryY=1;" edge="1" parent="1" source="d_bal" target="d_strat"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="865" y="320"/><mxPoint x="865" y="262"/></Array></mxGeometry></mxCell><mxCell id="ed4" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#AAB2C0;endArrow=block;endFill=0;exitX=0;exitY=0.5;entryX=0.2;entryY=1;" edge="1" parent="1" source="d_sim" target="d_strat"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="865" y="405"/><mxPoint x="865" y="262"/></Array></mxGeometry></mxCell><mxCell id="ed5" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#AAB2C0;endArrow=open;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d_svc" target="d_wal"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed6" value="releaseToSeller()" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#AAB2C0;endArrow=open;exitX=0;exitY=0.5;entryX=0;entryY=0.8;fontSize=10;horizontal=0;labelBackgroundColor=#FFFFFF;fontColor=#8A8F9A;" edge="1" parent="1" source="d_state" target="d_svc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="409"/><mxPoint x="530" y="220"/></Array></mxGeometry></mxCell><mxCell id="ed7" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#AAB2C0;endArrow=open;exitX=0;exitY=0.95;entryX=0.02;entryY=0;" edge="1" parent="1" source="d_svc" target="d_map"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="498" y="235"/><mxPoint x="498" y="454"/><mxPoint x="571" y="454"/></Array></mxGeometry></mxCell><mxCell id="d_note" value="The surrounding flow is identical for every method, so only settlement sits behind the interface. The fifth method, PayNow, added one class and one enum value — the order flow did not change." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontSize=11;fontColor=#8A8F9A;" vertex="1" parent="1"><mxGeometry x="560" y="545" width="560" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
