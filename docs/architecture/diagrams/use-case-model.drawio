<mxfile host="app.diagrams.net"><diagram name="Use cases" id="uc"><mxGraphModel dx="1200" dy="900" grid="0" page="1" pageWidth="1180" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" value="C2C SecTrade — use case model" style="text;html=1;fontSize=19;fontStyle=1;align=left;fontColor=#1F2A44;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="600" height="28" as="geometry"/></mxCell><mxCell id="sub" value="One ordinary role acts as buyer and seller. Dashed cases are planned extensions." style="text;html=1;fontSize=12;align=left;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="820" height="20" as="geometry"/></mxCell><mxCell id="sys" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#44546A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="230" y="84" width="920" height="648" as="geometry"/></mxCell><mxCell id="syst" value="C2C SecTrade" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#44546A;" vertex="1" parent="1"><mxGeometry x="256" y="92" width="300" height="20" as="geometry"/></mxCell><mxCell id="g0" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#6E8FC4;opacity=40;" vertex="1" parent="1"><mxGeometry x="250" y="118" width="880" height="76" as="geometry"/></mxCell><mxCell id="gl0" value="Accounts" style="text;html=1;fontSize=11;fontStyle=1;align=left;fontColor=#6E8FC4;" vertex="1" parent="1"><mxGeometry x="262" y="123" width="240" height="16" as="geometry"/></mxCell><mxCell id="u0_0" value="Register / sign in" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6E8FC4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="262" y="144" width="136" height="34" as="geometry"/></mxCell><mxCell id="u0_1" value="Manage profile and wallet" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6E8FC4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="406" y="144" width="183" height="3