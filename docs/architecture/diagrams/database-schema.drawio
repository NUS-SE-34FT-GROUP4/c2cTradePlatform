ntSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=1;" vertex="1" parent="helper"><mxGeometry y="24" width="250" height="48" as="geometry"/></mxCell><mxCell id="offer" value="bargain_offer" style="swimlane;html=1;fontSize=11;fontStyle=1;startSize=24;fillColor=#FFFFFF;strokeColor=#8A93A6;align=center;" vertex="1" parent="1"><mxGeometry x="35" y="480" width="250" height="72" as="geometry"/></mxCell><mxCell id="offer_b" value="product_id · buyer_id · seller_id&#10;from (BUYER / SELLER)&#10;price · status · order_id" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=1;" vertex="1" parent="offer"><mxGeometry y="24" width="250" height="48" as="geometry"/></mxCell><mxCell id="g5" value="" style="rounded=1;html=1;fillColor=#FBE9E7;strokeColor=none;opacity=35;" vertex="1" parent="1"><mxGeometry x="580" y="360" width="520" height="230" as="geometry"/></mxCell><mxCell id="g5_l" value="Trust, moderation and messaging" style="text;html=1;fontSize=11;fontStyle=1;align=left;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="590" y="366" width="200" height="16" as="geometry"/></mxCell><mxCell id="rev" value="review" style="swimlane;html=1;fontSize=11;fontStyle=1;startSize=24;fillColor=#FFFFFF;strokeColor=#8A93A6;align=center;" vertex="1" parent="1"><mxGeometry x="595" y="386" width="240" height="72" as="geometry"/></mxCell><mxCell id="rev_b" value="order_id →oms_order&#10;product_id · seller_id&#10;rating · content" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=1;" vertex="1" parent="rev"><mxGeometry y="24" width="240" height="48" as="geometry"/></mxCell><mxCell id="rep" value="report / admin_audit_log" style="swimlane;html=1;fontSize=11;fontStyle=1;startSize=24;fillColor=#FFFFFF;strokeColor=#8A93A6;align=center;" vertex="1" parent="1"><mxGeometry x="855" y="386" width="230" height="58" as="geometry"/></mxCell><mxCell id="rep_b" value="target · reason · status&#10;admin action trail" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=1;" vertex="1" parent="rep"><mxGeometry y="24" width="230" height="34" as="geometry"/></mxCell><mxCell id="chat" value="chat_message / system_notification" style="swimlane;html=1;fontSize=11;fontStyle=1;startSize=24;fillColor=#FFFFFF;strokeColor=#8A93A6;align=center;" vertex="1" parent="1"><mxGeometry x="595" y="490" width="490" height="58" as="geometry"/></mxCell><mxCell id="chat_b" value="sender · receiver · product_id&#10;content · read_at" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=1;" vertex="1" parent="chat"><mxGeometry y="24" width="490" height="34" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#AAB2C0;endArrow=none;" edge="1" parent="1" source="users" target="prod"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#AAB2C0;endArrow=none;" edge="1" parent="1" source="prod" target="media"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#AAB2C0;endArrow=none;" edge="1" parent="1" source="ord" target="item"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#AAB2C0;endArrow=none;dashed=1;" edge="1" parent="1" source="item" target="txn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#AAB2C0;endArrow=none;" edge="1" parent="1" source="prod" target="ord"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#AAB2C0;endArrow=none;" edge="1" parent="1" source="camp" target="helper"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#AAB2C0;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ord" target="rev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1" value="Money on an order is never edited in place. A payment, a payout to the seller and a refund are three rows in oms_transaction; what is still held against an order is payments less payouts and refunds, so a dispute is read off the ledger, not argued from one number. users.balance is the wallet figure, changed only under a row lock (SELECT … FOR UPDATE)." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontSize=11;fontColor=#8A6D3B;" vertex="1" parent="1"><mxGeometry x="1120" y="46" width="280" height="180" as="geometry"/></mxCell><mxCell id="n2" value="Stock is held, not deducted: pms_product.reserved_stock carries what unpaid orders hold, so availability is stock less reserved_stock. A conditional UPDATE naming the old value is what stops two buyers taking the last unit." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontSize=11;fontColor=#3F6B4F;" vertex="1" parent="1"><mxGeometry x="1120" y="250" width="280" height="160" as="geometry"/></mxCell><mxCell id="n3" value="Migrations live in scripts/migrations and run in name order on every deployment. Each one is additive and safe to rerun, so staging and production converge without anyone editing a schema by hand." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="1120" y="440" width="280" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
