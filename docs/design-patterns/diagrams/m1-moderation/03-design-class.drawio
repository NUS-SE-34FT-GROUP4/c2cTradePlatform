<mxfile host="drawio"><diagram name="design-class"><mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Administrator moderates a report: design classes (as in the code)&lt;/b&gt;" style="text;html=1;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="600" height="22" as="geometry"/></mxCell><mxCell id="c2" value='&lt;div style="text-align:center"&gt;&lt;b&gt;SecurityConfig&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;/api/admin/** → hasRole("ADMIN")' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f5f5f5;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="230" height="54" as="geometry"/></mxCell><mxCell id="c3" value='&lt;div style="text-align:center"&gt;&amp;laquo;RestController&amp;raquo;&lt;br&gt;&lt;b&gt;AdminModerationController&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;+reports(status, targetType, page, size)&lt;br&gt;+uphold(id, NoteRequest, Authentication)&lt;br&gt;+dismiss(id, NoteRequest, Authentication)&lt;br&gt;+ban(id, BanRequest, Authentication)&lt;br&gt;+reinstate(id, NoteRequest, Authentication)&lt;br&gt;+auditLog(action, page, size)' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#dae8fc;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="260" height="138" as="geometry"/></mxCell><mxCell id="c4" value='&lt;div style="text-align:center"&gt;&amp;laquo;Service&amp;raquo;&lt;br&gt;&lt;b&gt;ModerationService&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;+queue(status, targetType, page, size)&lt;br&gt;+uphold(admin, reportId, note) «Transactional»&lt;br&gt;+dismiss(admin, reportId, note) «Transactional»&lt;br&gt;+ban(admin, userId, reason) «Transactional»&lt;br&gt;+reinstate(admin, userId, note) «Transactional»&lt;br&gt;+auditLog(action, page, size)&lt;br&gt;-openReport(id) : Report&lt;br&gt;-checkBannable(admin, target)&lt;br&gt;-applyBan(admin, target, reason, reportId)&lt;br&gt;-audit(admin, action, type, id, reportId, note)' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#d5e8d4;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="40" width="280" height="194" as="geometry"/></mxCell><mxCell id="c5" value='&lt;div style="text-align:center"&gt;&amp;laquo;Mapper&amp;raquo;&lt;br&gt;&lt;b&gt;ReportMapper&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;+selectForQueue(status, type, limit, offset)&lt;br&gt;+selectByIdForUpdate(id) : Report&lt;br&gt;+decide(id, status, decidedBy, note)&lt;br&gt;+decideAllOpenOnTarget(type, id, status, by, note)' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="690" y="40" width="260" height="110" as="geometry"/></mxCell><mxCell id="c6" value='&lt;div style="text-align:center"&gt;&amp;laquo;Mapper&amp;raquo;&lt;br&gt;&lt;b&gt;AdminAuditLogMapper&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;+insert(AdminAuditLog)&lt;br&gt;+select(action, limit, offset)' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="690" y="175" width="260" height="82" as="geometry"/></mxCell><mxCell id="c7" value='&lt;div style="text-align:center"&gt;&amp;laquo;Mapper&amp;raquo;&lt;br&gt;&lt;b&gt;UserMapper&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;+selectById(id)&lt;br&gt;+selectByUsernameWithRoles(name)&lt;br&gt;+updateBan(id, status, reason, at)' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="690" y="270" width="260" height="96" as="geometry"/></mxCell><mxCell id="c8" value='&lt;div style="text-align:center"&gt;&amp;laquo;Mapper&amp;raquo;&lt;br&gt;&lt;b&gt;ProductMapper&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;+selectById(id)&lt;br&gt;+updateStatus(id, status)' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="690" y="375" width="260" height="82" as="geometry"/></mxCell><mxCell id="c9" value='&lt;div style="text-align:center"&gt;&amp;laquo;entity&amp;raquo;&lt;br&gt;&lt;b&gt;Report&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;-id, reporterId&lt;br&gt;-targetType : PRODUCT | USER&lt;br&gt;-targetId&lt;br&gt;-reason, detail&lt;br&gt;-status : OPEN | UPHELD | DISMISSED&lt;br&gt;-decidedBy, decisionNote&lt;br&gt;-createdAt, decidedAt' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1010" y="40" width="200" height="152" as="geometry"/></mxCell><mxCell id="c10" value='&lt;div style="text-align:center"&gt;&amp;laquo;entity&amp;raquo;&lt;br&gt;&lt;b&gt;AdminAuditLog&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;-id, adminId&lt;br&gt;-action&lt;br&gt;-targetType, targetId&lt;br&gt;-reportId&lt;br&gt;-note, createdAt' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1010" y="230" width="200" height="124" as="geometry"/></mxCell><mxCell id="c11" value='&lt;div style="text-align:center"&gt;&amp;laquo;enumeration&amp;raquo;&lt;br&gt;&lt;b&gt;ReportReason&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;FRAUD&lt;br&gt;PROHIBITED_ITEM&lt;br&gt;MISLEADING&lt;br&gt;HARASSMENT&lt;br&gt;SPAM&lt;br&gt;OTHER' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="290" width="200" height="138" as="geometry"/></mxCell><mxCell id="c12" value='&lt;div style="text-align:center"&gt;&lt;b&gt;ModerationException&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;badRequest() 400&lt;br&gt;notFound() 404&lt;br&gt;conflict() 409' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="230" height="82" as="geometry"/></mxCell><mxCell id="c13" value="guards" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=0;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="moderation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="maps" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=0;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="maps" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=0;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=0;dashed=1;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="throws" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=0;dashed=1;exitX=0;exitY=0.95;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="Every admin action writes its AdminAuditLog row in the same&lt;br&gt;transaction as the change. selectByIdForUpdate locks the report,&lt;br&gt;so two admins cannot decide it twice." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="440" width="330" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
