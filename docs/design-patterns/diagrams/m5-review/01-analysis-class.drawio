              <mxPoint x="820.0" y="405.9" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c7" value="Domain relations: one Order contains 1..* PurchasedItems. One Order has 0..1 Review. Each Review rates&lt;br&gt;exactly one purchased Product and the order seller. Buyer and Seller are roles of User. Associations use IDs in&lt;br&gt;the implemented design." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacing=10;fillColor=#FFF8DE;strokeColor=#AE994F;fontFamily=Arial;fontSize=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="810" width="910" height="90.2" />
        </mxCell>
        <mxCell id="c8" value="UC20 | Transition: S0 boundary, S1 entities, S2 control. Conceptual operations move to services/mappers." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1001" width="940" height="18.2" />
        </mxCell>
      </root>
