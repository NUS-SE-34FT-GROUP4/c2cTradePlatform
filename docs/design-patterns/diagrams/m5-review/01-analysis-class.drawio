        <mxCell id="c6" value="" edge="1" parent="1" style="html=1;rounded=0;strokeColor=#526477;fontFamily=Arial;fontSize=17;endArrow=none;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" source="c" target="r">
