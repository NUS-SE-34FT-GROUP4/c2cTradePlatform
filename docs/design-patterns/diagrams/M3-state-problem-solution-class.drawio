<mxfile host="app.diagrams.net"><diagram name="State" id="state"><mxGraphModel dx="1200" dy="600" grid="0" page="1" pageWidth="1160" pageHeight="440" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h1" value="Before — the rules lived in if-statements" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#A5603F;" vertex="1" parent="1"><mxGeometry x="24" y="10" width="420" height="22" as="geometry"/></mxCell><mxCell id="h2" value="After — the status knows its own rules" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#3F6B4F;" vertex="1" parent="1"><mxGeometry x="606" y="10" width="420" height="22" as="geometry"/></mxCell><mxCell id="b_ord" value="OrderService" style="swimlane;html=1;fontSize=12;fontStyle=1;startSize=26;fillColor=#FBE9E7;strokeColor=#C1705B;align=center;" vertex="1" parent="1"><mxGeometry x="24" y="44" width="300" height="137" as="geometry"/></mxCell><mxCell id="b_ord_b" value="pay(orderId, …) · ship(orderId)&#10;confirmReceipt(orderId)&#10;cancel(orderId) · refund(orderId)&#10;&#10;each one: load, check the status&#10;with an if, set the new status,&#10;save, then its own side effects" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="b_ord"><mxGeometry y="26" width="300" height="111" as="geometry"/></mxCell><mxCell id="b_entity" value="Order" style="swimlane;html=1;fontSize=12;fontStyle=1;startSize=26;fillColor=#FBE9E7;strokeColor=#C1705B;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="44" width="200" height="47" as="geometry"/></mxCell><mxCell id="b_entity_b" value="status : String" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="b_entity"><mxGeometry y="26" width="200" height="21" as="geometry"/></m