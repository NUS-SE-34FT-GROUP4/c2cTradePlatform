ry"/></mxCell><mxCell id="c30" style="endArrow=block;endFill=1;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="451" y="422" as="sourcePoint"/><mxPoint x="451" y="440" as="targetPoint"/><Array as="points"><mxPoint x="481" y="422"/><mxPoint x="481" y="440"/></Array></mxGeometry></mxCell><mxCell id="c31" value="7. transition(id, PENDING_PAYMENT → CANCELLED)&#xa;UPDATE … WHERE id = ? AND status = &#x27;PENDING_PAYMENT&#x27;" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="455" y="462" width="328" height="28" as="geometry"/></mxCell><mxCell id="c32" style="endArrow=block;endFill=1;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="451" y="494" as="sourcePoint"/><mxPoint x="787" y="494" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="1 row changed" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#6BA87F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="455" y="510" width="328" height="14" as="geometry"/></mxCell><mxCell id="c34" style="endArrow=open;endFill=0;html=1;strokeColor=#6BA87F;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="787" y="528" as="sourcePoint"/><mxPoint x="451" y="528" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="8. transition(id, PENDING_PAYMENT → EXPIRED)" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="791" y="544" width="496" height="14" as="geometry"/></mxCell><mxCell id="c36" style="endArrow=block;endFill=1;html=1;strokeColor=#D9A05B;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint 