<mxfile host="drawio"><diagram name="04 Solution sequence" id="d1"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="0" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Solution — sequence: the same race, with the State pattern" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#2B2F36;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1344" height="24" as="geometry"/></mxCell><mxCell id="c4" value="OrderStatus decides legal moves and actors; the update names the state being left. Blue = buyer request · amber = expiry job · green = outcome" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=bottom;fontSize=11;fontColor=#5B6270;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1344" height="18" as="geometry"/></mxCell><mxCell id="c5" value="Buyer" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB2C0;fontSize=11;fontColor=#2B2F36;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="43" y="80" width="144" height="42" as="geometry"/></mxCell><mxCell id="c6" value="OrderController" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB2C0;fontSize=11;fontColor=#2B2F36;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="211" y="80" width="144" height="42" as="geometry"/></mxCell><mxCell id="c7" value="OrderStateService" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB2C0;fontSize=11;fontColor=#2B2F36;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="379" y="80" width="144" height="42" as="geometry"/></mxCell><mxCell id="c8" value="«enum»&#xa;OrderStatus" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB2C