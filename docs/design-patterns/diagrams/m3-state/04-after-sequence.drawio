x="455" y="680" width="496" height="14" as="geometry"/></mxCell><mxCell id="c44" style="endArrow=block;endFill=1;html=1;strokeColor=#6BA87F;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="451" y="698" as="sourcePoint"/><mxPoint x="955" y="698" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="11. publishEvent(OrderStateChangedEvent)   → handled AFTER_COMMIT" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="455" y="714" width="664" height="14" as="geometry"/></mxCell><mxCell id="c46" style="endArrow=block;endFill=1;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="451" y="732" as="sourcePoint"/><mxPoint x="1123" y="732" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c47" value="updated order [CANCELLED]" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#6E8FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="287" y="748" width="160" height="14" as="geometry"/></mxCell><mxCell id="c48" style="endArrow=open;endFill=0;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="451" y="766" as="sourcePoint"/><mxPoint x="283" y="766" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c49" style="endArrow=none;endFill=0;html=1;strokeColor=#AAB2C0;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="122" as="sourcePoint"/><mxPoint x="115" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" style="endArrow=none;endFill=0;html=1;strokeColor=#AAB2C0;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="283" y="122" as="sourcePoint"/><mxPoint x="283" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c51" style="endArrow=none;endFill=0;html=1;strokeColor=#AAB2C0;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="451" y="122" as="sourcePoint"/><mxPoint x="451" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c52" style="endArrow=none;endFill=0;html=1;strokeColor=#AAB2C0;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="619" y="122" as="sourcePoint"/><mxPoint x="619" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" style="endArrow=none;endFill=0;html=1;strokeColor=#AAB2C0;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="787" y="122" as="sourcePoint"/><mxPoint x="787" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c54" style="endArrow=none;endFill=0;html=1;strokeColor=#AAB2C0;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="955" y="122" as="sourcePoint"/><mxPoint x="955" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c55" style="endArrow=none;endFill=0;html=1;strokeColor=#AAB2C0;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1123" y="122" as="sourcePoint"/><mxPoint x="1123" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c56" style="endArrow=none;endFill=0;html=1;strokeColor=#AAB2C0;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1291" y="122" as="sourcePoint"/><mxPoint x="1291" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c57" value="&lt;b&gt;What the pattern changes&lt;/b&gt;&lt;br&gt;① Legal moves and who may act come from &lt;code&gt;OrderStatus&lt;/code&gt; — one place, the same for every action.&lt;br&gt;② &lt;code&gt;transition&lt;/code&gt; names the state being left, so of two racing writers exactly one changes a row; the loser does nothing.&lt;br&gt;③ Side effects follow from what the state holds (a reservation, a payment), not from the action name — so the stock is released once." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#E4F2E8;strokeColor=#6BA87F;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1344" height="86" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>