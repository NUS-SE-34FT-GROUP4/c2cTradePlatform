<mxfile host="drawio"><diagram name="03 Problem sequence" id="d1"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="0" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Problem — sequence: a buyer cancels while the expiry job expires the same unpaid order" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#2B2F36;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1050" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Before the State pattern: OrderService as at commit 4b765b0^, with expireOverdueOrders() called on a schedule (Sprint 3). Blue = buyer request · amber = expiry job · red = wrong result" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=bottom;fontSize=11;fontColor=#5B6270;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1050" height="18" as="geometry"/></mxCell><mxCell id="c5" value="Buyer" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB2C0;fontSize=11;fontColor=#2B2F36;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="43" y="80" width="144" height="42" as="geometry"/></mxCell><mxCell id="c6" value="OrderController" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB2C0;fontSize=11;fontColor=#2B2F36;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="218" y="80" width="144" height="42" as="geometry"/></mxCell><mxCell id="c7" value="OrderService" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB2C0;fontSize=11;fontColor=#2B2F36;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="393" y="80" width="144" height="42" as="geometry"/></mxCell><mxCell id="c8" value="OrderMapper" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB2C0;fontSize=11;fontColor=#2B2F36;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="568" y="80" width="144" height="42" as="geometry"/></mxCell><mxCell id="c9" value="ProductMapper" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB2C0;fontSize=11;fontColor=#2B2F36;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="743" y="80" width="144" height="42" as="geometry"/></mxCell><mxCell id="c10" value="«scheduled»&#xa;OrderExpiryJob" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB2C0;fontSize=11;fontColor=#2B2F36;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="918" y="80" width="144" height="42" as="geometry"/></mxCell><mxCell id="c11" value="1. POST /api/orders/{id}/cancel" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="119" y="132" width="167" height="14" as="geometry"/></mxCell><mxCell id="c12" style="endArrow=block;endFill=1;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="150" as="sourcePoint"/><mxPoint x="290" y="150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="2. cancel(buyerId, orderId)" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="294" y="166" width="167" height="14" as="geometry"/></mxCell><mxCell id="c14" style="endArrow=block;endFill=1;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="184" as="sourcePoint"/><mxPoint x="465" y="184" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="3. selectById(orderId)" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="469" y="200" width="167" height="14" as="geometry"/></mxCell><mxCell id="c16" style="endArrow=block;endFill=1;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="218" as="sourcePoint"/><mxPoint x="640" y="218" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="order [PENDING_PAYMENT]" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#6E8FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="469" y="234" width="167" height="14" as="geometry"/></mxCell><mxCell id="c18" style="endArrow=open;endFill=0;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="252" as="sourcePoint"/><mxPoint x="465" y="252" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="4. order.buyerId == buyerId ?&#xa;&quot;PENDING_PAYMENT&quot;.equals(order.status) ?" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="503" y="284" width="250" height="32" as="geometry"/></mxCell><mxCell id="c20" style="endArrow=block;endFill=1;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="286" as="sourcePoint"/><mxPoint x="465" y="314" as="targetPoint"/><Array as="points"><mxPoint x="495" y="286"/><mxPoint x="495" y="314"/></Array></mxGeometry></mxCell><mxCell id="c21" value="5. expireOverdueOrders()" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="469" y="336" width="517" height="14" as="geometry"/></mxCell><mxCell id="c22" style="endArrow=block;endFill=1;html=1;strokeColor=#D9A05B;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="990" y="354" as="sourcePoint"/><mxPoint x="465" y="354" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="6. selectExpiredPending(now)" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="469" y="370" width="167" height="14" as="geometry"/></mxCell><mxCell id="c24" style="endArrow=block;endFill=1;html=1;strokeColor=#D9A05B;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="388" as="sourcePoint"/><mxPoint x="640" y="388" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="[ the same order ]" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#D9A05B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="469" y="404" width="167" height="14" as="geometry"/></mxCell><mxCell id="c26" style="endArrow=open;endFill=0;html=1;strokeColor=#D9A05B;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="422" as="sourcePoint"/><mxPoint x="465" y="422" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="7. releaseStock(productId, q)   — cancel path" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="469" y="438" width="342" height="14" as="geometry"/></mxCell><mxCell id="c28" style="endArrow=block;endFill=1;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="456" as="sourcePoint"/><mxPoint x="815" y="456" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="8. updateStatus(id, CANCELLED)&#xa;UPDATE … SET status = ? WHERE id = ?" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="469" y="472" width="167" height="28" as="geometry"/></mxCell><mxCell id="c30" style="endArrow=block;endFill=1;html=1;strokeColor=#6E8FC4;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="504" as="sourcePoint"/><mxPoint x="640" y="504" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="9. releaseStock(productId, q)   — released a second time" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#C1705B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="469" y="520" width="342" height="14" as="geometry"/></mxCell><mxCell id="c32" style="endArrow=block;endFill=1;html=1;strokeColor=#C1705B;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="538" as="sourcePoint"/><mxPoint x="815" y="538" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="10. updateStatus(id, EXPIRED)   — overwrites CANCELLED" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=bottom;fontSize=11;fontColor=#C1705B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="469" y="554" width="167" height="14" as="geometry"/></mxCell><mxCell id="c34" style="endArrow=block;endFill=1;html=1;strokeColor=#C1705B;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="572" as="sourcePoint"/><mxPoint x="640" y="572" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" style="endArrow=none;endFill=0;html=1;strokeColor=#AAB2C0;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="122" as="sourcePoint"/><mxPoint x="115" y="606" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" style="endArrow=none;endFill=0;html=1;strokeColor=#AAB2C0;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="122" as="sourcePoint"/><mxPoint x="290" y="606" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" style="endArrow=none;endFill=0;html=1;strokeColor=#AAB2C0;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="122" as="sourcePoint"/><mxPoint x="465" y="606" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" style="endArrow=none;endFill=0;html=1;strokeColor=#AAB2C0;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="122" as="sourcePoint"/><mxPoint x="640" y="606" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" style="endArrow=none;endFill=0;html=1;strokeColor=#AAB2C0;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="815" y="122" as="sourcePoint"/><mxPoint x="815" y="606" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" style="endArrow=none;endFill=0;html=1;strokeColor=#AAB2C0;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="990" y="122" as="sourcePoint"/><mxPoint x="990" y="606" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="&lt;b&gt;What goes wrong&lt;/b&gt;&lt;br&gt;① Which status allows the action, and who may perform it, are re-written by hand in every method (cancel, expire, pay …).&lt;br&gt;② The status is written with &lt;code&gt;WHERE id = ?&lt;/code&gt; only — the state being left is never checked, so the later writer silently wins.&lt;br&gt;③ Both paths release the reservation. &lt;code&gt;reserved_stock&lt;/code&gt; drops twice, freeing units that other buyers&#x27; unpaid orders are holding." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FBE9E7;strokeColor=#C1705B;fontSize=11;fontColor=#2B2F36;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="616" width="1050" height="86" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>