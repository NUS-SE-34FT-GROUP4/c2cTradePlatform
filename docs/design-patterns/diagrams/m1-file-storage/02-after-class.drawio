<mxfile host="drawio"><diagram name="after-class"><mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;After: Strategy. Controllers depend on FileStorageService; MinIO lives in one class&lt;/b&gt;" style="text;html=1;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="700" height="22" as="geometry"/></mxCell><mxCell id="c2" value='&lt;div style="text-align:center"&gt;&amp;laquo;RestController  (Context)&amp;raquo;&lt;br&gt;&lt;b&gt;AvatarController&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;-storage : FileStorageService&lt;hr size="1"&gt;+upload(file, auth)' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#dae8fc;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="210" height="94" as="geometry"/></mxCell><mxCell id="c3" value='&lt;div style="text-align:center"&gt;&amp;laquo;RestController  (Context)&amp;raquo;&lt;br&gt;&lt;b&gt;ProductController&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;-storage : FileStorageService&lt;hr size="1"&gt;+uploadMedia(file, auth)' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#dae8fc;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="260" y="40" width="210" height="94" as="geometry"/></mxCell><mxCell id="c4" value='&lt;div style="text-align:center"&gt;&amp;laquo;RestController  (Context)&amp;raquo;&lt;br&gt;&lt;b&gt;ReviewController&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;-storage : FileStorageService&lt;hr size="1"&gt;+image(file)' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#dae8fc;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="500" y="40" width="210" height="94" as="geometry"/></mxCell><mxCell id="c5" value='&lt;div style="text-align:center"&gt;&amp;laquo;interface  (Strategy)&amp;raquo;&lt;br&gt;&lt;b&gt;FileStorageService&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;+upload(file, folder) : String&lt;br&gt;+delete(objectName)' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#d5e8d4;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="250" y="190" width="250" height="82" as="geometry"/></mxCell><mxCell id="c6" value='&lt;div style="text-align:center"&gt;&amp;laquo;Service  (Concrete strategy)&amp;raquo;&lt;br&gt;&lt;b&gt;MinioFileStorageService&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;-MAX_BYTES = 10 MB&lt;br&gt;-ALLOWED_TYPES = jpeg, png, gif, webp, mp4&lt;hr size="1"&gt;+ensureBucket()  «PostConstruct»&lt;br&gt;+upload(file, folder) : String&lt;br&gt;+delete(objectName)&lt;br&gt;-publicUrl(objectName)&lt;br&gt;-extensionOf(filename)&lt;br&gt;-publicReadPolicy(bucket)' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#d5e8d4;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="230" y="310" width="290" height="178" as="geometry"/></mxCell><mxCell id="c7" value='&lt;div style="text-align:center"&gt;&amp;laquo;MinIO SDK&amp;raquo;&lt;br&gt;&lt;b&gt;MinioClient&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;+putObject(PutObjectArgs)' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f5f5f5;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="600" y="330" width="190" height="68" as="geometry"/></mxCell><mxCell id="c8" value='&lt;div style="text-align:center"&gt;&lt;b&gt;MinioProperties&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;endpoint, publicEndpoint, bucketName' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f5f5f5;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="600" y="430" width="260" height="54" as="geometry"/></mxCell><mxCell id="c9" value='&lt;div style="text-align:center"&gt;&amp;laquo;possible next strategy&amp;raquo;&lt;br&gt;&lt;b&gt;S3 / LocalDisk storage&lt;/b&gt;&lt;/div&gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="170" height="42" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=0;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=0;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=0;dashed=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value='Spring injects the one bean that implements FileStorageService.&lt;br&gt;A folder goes in ("avatar", "product", "review"), a browser-loadable URL comes out.&lt;br&gt;The S3/LocalDisk box is not in the code; it shows where a second strategy plugs in.' style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="530" width="560" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
