<mxfile host="drawio"><diagram name="analysis-class"><mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Search listings by keyword: analysis classes&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="24" as="geometry"/></mxCell><mxCell id="c4" value='&lt;div style="text-align:center"&gt;&amp;laquo;boundary&amp;raquo;&lt;br&gt;&lt;b&gt;Catalogue Search Page&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;enterKeyword(text)&lt;br&gt;setFilters(price, condition,&lt;br&gt;    location, categories)&lt;br&gt;showResults(listings)' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#dae8fc;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="300" height="130" as="geometry"/></mxCell><mxCell id="c5" value='&lt;div style="text-align:center"&gt;&amp;laquo;control&amp;raquo;&lt;br&gt;&lt;b&gt;Search Listings&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;search(keyword, filters)&lt;br&gt;rankByRelevance(matches)&lt;br&gt;highlight(results, keyword)' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#d5e8d4;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="50" width="320" height="130" as="geometry"/></mxCell><mxCell id="c6" value='&lt;div style="text-align:center"&gt;&amp;laquo;entity&amp;raquo;&lt;br&gt;&lt;b&gt;Listing&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;name&lt;br&gt;description&lt;br&gt;category&lt;br&gt;price&lt;br&gt;condition&lt;br&gt;location&lt;br&gt;stock / reservedStock&lt;br&gt;status : listed | delisted&lt;br&gt;createdAt' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#fff2cc;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="50" width="300" height="200" as="geometry"/></mxCell><mxCell id="c7" value='&lt;div style="text-align:center"&gt;&amp;laquo;entity&amp;raquo;&lt;br&gt;&lt;b&gt;Seller&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;displayName&lt;br&gt;avatar' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#fff2cc;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="50" width="260" height="100" as="geometry"/></mxCell><mxCell id="c8" value='&lt;div style="text-align:center"&gt;&amp;laquo;actor&amp;raquo;&lt;br&gt;&lt;b&gt;Buyer (any visitor)&lt;/b&gt;&lt;/div&gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="300" height="60" as="geometry"/></mxCell><mxCell id="c9" value='&lt;div style="text-align:center"&gt;&amp;laquo;boundary&amp;raquo;&lt;br&gt;&lt;b&gt;Search Engine&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;rank(keyword, filters) :&lt;br&gt;    ordered listing ids' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#dae8fc;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="330" width="320" height="100" as="geometry"/></mxCell><mxCell id="c10" value='&lt;div style="text-align:center"&gt;&amp;laquo;entity&amp;raquo;&lt;br&gt;&lt;b&gt;Listing Media&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;url&lt;br&gt;type : image | video&lt;br&gt;sortOrder' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#fff2cc;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="360" width="300" height="110"