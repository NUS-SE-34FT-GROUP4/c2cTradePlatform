l=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="sold by" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="has" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="Every result is a listing that matches the keyword and filters, is listed and still has stock.&lt;br&gt;The search engine only puts those matches in order. With zero or one match there is&lt;br&gt;nothing to order, and if the engine is unavailable the search still answers in the&lt;br&gt;listings&amp;#x27; own relevance order." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="640" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
