<mxfile host="drawio"><diagram name="design-class"><mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Search listings by keyword: design classes (as in the code)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="24" as="geometry"/></mxCell><mxCell id="c4" value='&lt;div style="text-align:center"&gt;&amp;laquo;Vue page&amp;raquo;&lt;br&gt;&lt;b&gt;HomeView (frontend)&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;performSearch(): productService.getAllProducts(params)&lt;br&gt;  (runs 500 ms after typing stops)&lt;br&gt;renders highlightedName;&lt;br&gt;pages the results in the browser' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="340" height="118" as="geometry"/></mxCell><mxCell id="c5" value='&lt;div style="text-align:center"&gt;&amp;laquo;RestController&amp;raquo;&lt;br&gt;&lt;b&gt;ProductController&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;+listProducts(keyword, minPrice, maxPrice,&lt;br&gt;    conditionLevel, location, categories)&lt;br&gt;    : ResponseEntity&amp;lt;List&amp;lt;ProductDTO&amp;gt;&amp;gt;&lt;br&gt;  any exception → 500' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#dae8fc;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="225" width="340" height="130" as="geometry"/></mxCell><mxCell id="c6" value='&lt;div style="text-align:center"&gt;&lt;b&gt;SecurityConfig&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;GET /api/products → permitAll()' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="340" height="60" as="geometry"/></mxCell><mxCell id="c7" value="ElasticsearchClientConfig: at most 50 connections,&lt;br&gt;wait at most 250 ms for one, 1 s socket timeout.&lt;br&gt;Any failure: the SQL order is kept&lt;br&gt;(logged as path=sql_fallback)." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="340" height="96" as="geometry"/></mxCell><mxCell id="c8" value='&lt;div style="text-align:center"&gt;&amp;laquo;Service&amp;raquo;&lt;br&gt;&lt;b&gt;SearchService&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;-searchQuery : ProductSearchQuery&lt;br&gt;-productService : ProductService&lt;br&gt;+search(keyword, minPrice, maxPrice, conditionLevel,&lt;br&gt;    location, categories) : List&amp;lt;ProductDTO&amp;gt;&lt;br&gt;+highlight(results, keyword) : List&amp;lt;ProductDTO&amp;gt;&lt;br&gt;-sqlSearch(criteria) : List&amp;lt;Product&amp;gt;&lt;br&gt;-finish(products, criteria, path, …) : List&amp;lt;ProductDTO&amp;gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#d5e8d4;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="50" width="400" height="170" as="geometry"/></mxCell><mxCell id="c9" value='&lt;div style="text-align:center"&gt;&amp;laquo;interface&amp;raquo;&lt;br&gt;&lt;b&gt;ProductSearchQuery&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;+search(criteria) : List&amp;lt;Long&amp;gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="280" width="400" height="72" as="geometry"/></mxCell><mxCell id="c10" value='&lt;div style="text-align:center"&gt;&lt;b&gt;ElasticsearchProductSearchQuery&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;MAX_RESULTS = 1000&lt;br&gt;+search(criteria) : List&amp;lt;Long&amp;gt;&lt;br&gt;~buildQuery(criteria) : NativeQuery&lt;br&gt;  (Adapter, see 3.5.2)' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="400" width="400" height="110" as="geometry"/></mxCell><mxCell id="c11" value='&lt;div style="text-align:center"&gt;&amp;laquo;Spring Data&amp;raquo;&lt;br&gt;&lt;b&gt;ElasticsearchOperations&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;search(query, ProductSearchDocument.class)&lt;br&gt;  index &amp;quot;products&amp;quot;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="560" width="400" height="84" as="geometry"/></mxCell><mxCell id="c12" value='&lt;div style="text-align:center"&gt;&amp;laquo;record&amp;raquo;&lt;br&gt;&lt;b&gt;ProductSearchCriteria&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;keyword, minPrice, maxPrice,&lt;br&gt;conditionLevel, location, categories&lt;br&gt;+hasKeyword() : boolean&lt;br&gt;+categoryValues() : List&amp;lt;String&amp;gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="690" width="400" height="110" as="geometry"/></mxCell><mxCell id="c13" value='&lt;div style="text-align:center"&gt;&amp;laquo;Service&amp;raquo;&lt;br&gt;&lt;b&gt;ProductService&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;+listProductsWithFilters(keyword, minPrice, maxPrice,&lt;br&gt;    conditionLevel, location, category) : List&amp;lt;Product&amp;gt;&lt;br&gt;-attachMedia(products)&lt;br&gt;+convertToDTOList(products) : List&amp;lt;ProductDTO&amp;gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#d5e8d4;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="50" width="420" height="120" as="geometry"/></mxCell><mxCell id="c14" value='&lt;div style="text-align:center"&gt;&amp;laquo;Service&amp;raquo;&lt;br&gt;&lt;b&gt;CreditService&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;+forSellers(sellerIds) : Map&amp;lt;Long, CreditSummary&amp;gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#d5e8d4;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="220" width="420" height="72" as="geometry"/></mxCell><mxCell id="c15" value='&lt;div style="text-align:center"&gt;&amp;laquo;entity&amp;raquo;&lt;br&gt;&lt;b&gt;Product  (mapped by ProductMapper)&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;-id, userId&lt;br&gt;-name, description, category&lt;br&gt;-price : BigDecimal&lt;br&gt;-conditionLevel, location&lt;br&gt;-stock, reservedStock&lt;br&gt;-status&lt;br&gt;-createdAt&lt;br&gt;-media : List&amp;lt;ProductMedia&amp;gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#fff2cc;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="330" width="420" height="180" as="geometry"/></mxCell><mxCell id="c16" value='&lt;div style="text-align:center"&gt;&amp;laquo;DTO&amp;raquo;&lt;br&gt;&lt;b&gt;ProductDTO&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;-id, name, description, price, …&lt;br&gt;-media : List&amp;lt;MediaItem&amp;gt;&lt;br&gt;-sellerCredit : CreditSummary&lt;br&gt;-displayName, avatarUrl&lt;br&gt;-highlightedName, highlightedDescription' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="560" width="420" height="134" as="geometry"/></mxCell><mxCell id="c17" value='&lt;div style="text-align:center"&gt;&amp;laquo;Mapper&amp;raquo;&lt;br&gt;&lt;b&gt;ProductMapper&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;+selectWithFilters(keyword, minPrice, maxPrice,&lt;br&gt;    conditionLevel, location, category)&lt;br&gt;    : List&amp;lt;Product&amp;gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1420" y="40" width="420" height="104" as="geometry"/></mxCell><mxCell id="c18" value='&lt;div style="text-align:center"&gt;&amp;laquo;Mapper&amp;raquo;&lt;br&gt;&lt;b&gt;ProductMediaMapper&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;+selectByProductIds(productIds) : List&amp;lt;ProductMedia&amp;gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1420" y="158" width="420" height="72" as="geometry"/></mxCell><mxCell id="c19" value='&lt;div style="text-align:center"&gt;&amp;laquo;Mapper&amp;raquo;&lt;br&gt;&lt;b&gt;CreditMapper&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;+selectHistory(sellerIds) : List&amp;lt;CreditHistory&amp;gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1420" y="244" width="420" height="72" as="geometry"/></mxCell><mxCell id="c20" value='&lt;div style="text-align:center"&gt;&amp;laquo;Mapper&amp;raquo;&lt;br&gt;&lt;b&gt;UserMapper&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;+selectByIds(ids) : List&amp;lt;User&amp;gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1420" y="330" width="420" height="72" as="geometry"/></mxCell><mxCell id="c21" value='&lt;div style="text-align:center"&gt;&amp;laquo;entity&amp;raquo;&lt;br&gt;&lt;b&gt;ProductMedia  (mapped by ProductMediaMapper)&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;-url&lt;br&gt;-mediaType : 1 image | 2 video&lt;br&gt;-sortOrder' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#fff2cc;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1420" y="430" width="420" height="104" as="geometry"/></mxCell><mxCell id="c22" value="S0: the controller carries protocol only.&lt;br&gt;S1: entities hold state; every query sits in a mapper, one&lt;br&gt;query per mapper call, so a page costs four queries, not n.&lt;br&gt;S2: one service method per use case; read-only, so no&lt;br&gt;transaction is opened.&lt;br&gt;MySQL decides which listings match; Elasticsearch only orders them." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1420" y="560" width="420" height="150" as="geometry"/></mxCell><mxCell id="c23" value="GET /api/products?keyword=…" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="guards" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" v